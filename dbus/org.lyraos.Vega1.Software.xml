<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/org/lyraos/Vega1">
  <interface name="org.lyraos.Vega1.Software">
    <!-- PackageRef struct: (origin, id, name, description, installed, icon, repository)
         origin -> "official" | "flathub" | "aur"
         repository -> source repo's display name, populated for ListUpdates
         (grouping key for the Updates tab), empty where it doesn't apply -->

    <method name="PackageManagerName">
      <arg name="name" type="s" direction="out"/>
    </method>

    <method name="CommunityLayerName">
      <arg name="name" type="s" direction="out"/>
    </method>

    <method name="GetPackageDetails">
      <arg name="origin" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="details" type="(ssssbssssasasss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="PackageDetails"/>
    </method>

    <method name="GetAurPkgbuild">
      <arg name="id" type="s" direction="in"/>
      <arg name="pkgbuild" type="s" direction="out"/>
    </method>

    <method name="Search">
      <!-- polkit: none (read-only) -->
      <arg name="query" type="s" direction="in"/>
      <arg name="results" type="a(ssssbss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;PackageRef&gt;"/>
    </method>

    <method name="Install">
      <!-- polkit: org.lyraos.vega.software.install -->
      <arg name="origin" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <method name="Remove">
      <!-- polkit: org.lyraos.vega.software.remove -->
      <arg name="origin" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <method name="ListUpdates">
      <!-- polkit: none (read-only) -->
      <arg name="results" type="a(ssssbss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;PackageRef&gt;"/>
    </method>

    <method name="ListInstalled">
      <!-- polkit: none (read-only) -->
      <arg name="results" type="a(ssssbss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;PackageRef&gt;"/>
    </method>

    <method name="UpdateAll">
      <!-- polkit: org.lyraos.vega.software.update -->
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <method name="UpdatePackage">
      <!-- polkit: org.lyraos.vega.software.update -->
      <!-- Updates a single pending update, pulling in whatever dependency
           bump it needs (the package manager's own resolver decides that),
           instead of running the full UpdateAll. -->
      <arg name="origin" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <method name="ListRepos">
      <!-- polkit: none (read-only) -->
      <arg name="repos" type="a(sb)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;RepoInfo&gt;"/>
    </method>

    <method name="SetRepoEnabled">
      <!-- polkit: org.lyraos.vega.software.manage-repos -->
      <arg name="repo" type="s" direction="in"/>
      <arg name="enabled" type="b" direction="in"/>
    </method>

    <method name="AddRepo">
      <!-- polkit: org.lyraos.vega.software.manage-repos -->
      <arg name="name" type="s" direction="in"/>
      <arg name="url" type="s" direction="in"/>
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <method name="TrustRepoKey">
      <!-- polkit: org.lyraos.vega.software.manage-repos -->
      <arg name="repo" type="s" direction="in"/>
      <arg name="keyId" type="s" direction="in"/>
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <method name="ClearCache">
      <!-- polkit: org.lyraos.vega.software.clear-cache -->
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <method name="NvidiaStatus">
      <!-- Read-only conservative G06 hardware/package preflight. -->
      <arg name="status" type="(bbbssssu)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="NvidiaStatus"/>
    </method>

    <method name="InstallNvidia">
      <!-- polkit: org.lyraos.vega.software.install-nvidia; confirmed must be true. -->
      <arg name="confirmed" type="b" direction="in"/>
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <method name="CheckNvidia">
      <!-- Post-reboot read-only validation of nvidia-smi and DRM connectors. -->
      <arg name="success" type="b" direction="out"/>
      <arg name="message" type="s" direction="out"/>
    </method>

    <method name="NonFreeFirmwareStatus">
      <arg name="status" type="(bbsas)" direction="out"/>
    </method>

    <method name="InstallNonFreeFirmware">
      <!-- polkit: org.lyraos.vega.software.install-firmware -->
      <arg name="confirmed" type="b" direction="in"/>
      <arg name="transactionId" type="u" direction="out"/>
    </method>

    <signal name="TransactionProgress">
      <arg name="transactionId" type="u"/>
      <arg name="percent" type="u"/>
      <arg name="message" type="s"/>
    </signal>

    <signal name="TransactionFinished">
      <arg name="transactionId" type="u"/>
      <arg name="success" type="b"/>
      <arg name="message" type="s"/>
    </signal>

    <signal name="RepoKeyPending">
      <!-- Emitido durante uma transação AddRepo/TrustRepoKey quando o
           repositório está assinado por uma chave ainda não confiada — a UI
           deve mostrar keyId/fingerprint/userId pro usuário aprovar e então
           chamar TrustRepoKey. A transação em si termina com
           success=false logo em seguida (ver TransactionFinished). -->
      <arg name="transactionId" type="u"/>
      <arg name="repo" type="s"/>
      <arg name="keyId" type="s"/>
      <arg name="fingerprint" type="s"/>
      <arg name="userId" type="s"/>
    </signal>

    <signal name="PackageProgress">
      <!-- Emitido durante uma transação Install/Remove/UpdateAll conduzida
           via zypper (modo XML), a cada avanço de download ou instalação de
           um pacote. phase -> "download" | "install". Origens sem essa
           granularidade (Flathub, AUR) nunca emitem este sinal — a UI deve
           tratar a ausência como "sem detalhe fino disponível" e usar só
           o TransactionProgress geral. -->
      <arg name="transactionId" type="u"/>
      <arg name="package" type="s"/>
      <arg name="phase" type="s"/>
      <arg name="percent" type="u"/>
    </signal>

    <signal name="UpdatesAvailable">
      <!-- emitted by vegad-update-check.timer (every 4h) when ListUpdates
           would return at least one pending update -->
      <arg name="count" type="u"/>
    </signal>
  </interface>
</node>
