{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vega",
  "mainBinaryName": "vega-gtk",
  "identifier": "org.lyraos.Vega",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "enableGTKAppId": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vega",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
